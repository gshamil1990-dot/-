rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'gshamil1990@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSharedModelFields(data) {
      return data.imageDataUrl is string
        && data.imageDataUrl.size() >= 32
        && data.imageDataUrl.size() <= 450000
        && data.imageDataUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && data.promptUsed is string
        && data.promptUsed.size() >= 1
        && data.promptUsed.size() <= 800
        && data.source in ['ai', 'upload']
        && data.isPublished is bool
        && data.approvedBy is string
        && data.approvedBy == request.auth.uid
        && data.approvedBy.size() >= 4
        && data.approvedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidColoringModel(data, techniqueId) {
      return data.keys().hasAll([
          'techniqueId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'techniqueId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.techniqueId is string
        && data.techniqueId == techniqueId
        && data.techniqueId.size() >= 2
        && data.techniqueId.size() <= 64
        && data.techniqueId.matches('^[a-z0-9\\-]+$')
        && isValidSharedModelFields(data);
    }

    function isValidHaircutModel(data, haircutId) {
      return data.keys().hasAll([
          'haircutId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'haircutId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.haircutId is string
        && data.haircutId == haircutId
        && data.haircutId.size() >= 2
        && data.haircutId.size() <= 64
        && data.haircutId.matches('^[a-z0-9\\-]+$')
        && isValidSharedModelFields(data);
    }

    function isValidCareModel(data, careId) {
      return data.keys().hasAll([
          'careId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'careId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.careId is string
        && data.careId == careId
        && data.careId.size() >= 2
        && data.careId.size() <= 64
        && data.careId.matches('^[a-z0-9\\-]+$')
        && isValidSharedModelFields(data);
    }

    function isValidStylingModel(data, stylingId) {
      return data.keys().hasAll([
          'stylingId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'stylingId',
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.stylingId is string
        && data.stylingId == stylingId
        && data.stylingId.size() >= 2
        && data.stylingId.size() <= 64
        && data.stylingId.matches('^[a-z0-9\\-]+$')
        && isValidSharedModelFields(data);
    }

    function isValidAdminMember(data, adminId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'createdAt'])
        && data.uid is string
        && data.uid == adminId
        && data.uid.size() >= 4
        && data.uid.size() <= 128
        && data.role == 'master'
        && data.createdAt is timestamp;
    }

    // Public showcase of approved coloring model photos (zero PII)
    match /coloring_models/{techniqueId} {
      allow get: if isValidId(techniqueId) && (resource == null || existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true;

      allow create: if isSignedIn()
        && isValidId(techniqueId)
        && isValidColoringModel(incoming(), techniqueId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(techniqueId)
        && isValidColoringModel(incoming(), techniqueId)
        && incoming().createdAt == existing().createdAt
        && incoming().techniqueId == existing().techniqueId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'updatedAt'
        ])
        && isAdmin();

      allow delete: if isSignedIn()
        && isValidId(techniqueId)
        && isAdmin();
    }

    // Public showcase of approved haircut model photos (zero PII)
    match /haircut_models/{haircutId} {
      allow get: if isValidId(haircutId) && (resource == null || existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true;

      allow create: if isSignedIn()
        && isValidId(haircutId)
        && isValidHaircutModel(incoming(), haircutId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(haircutId)
        && isValidHaircutModel(incoming(), haircutId)
        && incoming().createdAt == existing().createdAt
        && incoming().haircutId == existing().haircutId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'updatedAt'
        ])
        && isAdmin();

      allow delete: if isSignedIn()
        && isValidId(haircutId)
        && isAdmin();
    }

    // Public showcase of approved spa care model photos (zero PII)
    match /care_models/{careId} {
      allow get: if isValidId(careId) && (resource == null || existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true;

      allow create: if isSignedIn()
        && isValidId(careId)
        && isValidCareModel(incoming(), careId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(careId)
        && isValidCareModel(incoming(), careId)
        && incoming().createdAt == existing().createdAt
        && incoming().careId == existing().careId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'updatedAt'
        ])
        && isAdmin();

      allow delete: if isSignedIn()
        && isValidId(careId)
        && isAdmin();
    }

    // Public showcase of approved salon styling & hairstyle photos (zero PII)
    match /styling_models/{stylingId} {
      allow get: if isValidId(stylingId) && (resource == null || existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true;

      allow create: if isSignedIn()
        && isValidId(stylingId)
        && isValidStylingModel(incoming(), stylingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(stylingId)
        && isValidStylingModel(incoming(), stylingId)
        && incoming().createdAt == existing().createdAt
        && incoming().stylingId == existing().stylingId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'imageDataUrl',
          'promptUsed',
          'source',
          'isPublished',
          'approvedBy',
          'updatedAt'
        ])
        && isAdmin();

      allow delete: if isSignedIn()
        && isValidId(stylingId)
        && isAdmin();
    }

    // Master admin registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if false;

      allow create: if isBootstrappedAdmin()
        && isValidId(adminId)
        && isValidAdminMember(incoming(), adminId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }
  }
}
